[Desktop Entry]
Version=1.0
Name=UzbekGram Desktop
Comment=Unofficial Telegram client fork (UzbekGram)
Exec=uzbekgram -- %u
Icon=com.uzbekgram.desktop
Terminal=false
Type=Application
Categories=Network;InstantMessaging;Qt;
StartupWMClass=UzbekGram
StartupNotify=true
MimeType=x-scheme-handler/tg;
X-GNOME-UsesNotifications=true
X-GNOME-Gettext-Domain=tdesktop
X-GNOME-SingleWindow=false
X-KDE-Protocols=tg
