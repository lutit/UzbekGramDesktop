[Desktop Entry]
Name=UzbekGram
Comment=UzbekGram Desktop client
TryExec=uzbekgram
Exec=uzbekgram -- %U
Icon=com.uzbekgram.desktop
Terminal=false
StartupWMClass=UzbekGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;
Keywords=tg;chat;im;messaging;messenger;sms;uzbekgram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=uzbekgram -quit
Name=Quit UzbekGram
Icon=application-exit
